<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Minimal dark theme — the WebView content itself already renders the
         actual UI (same dark theme as the site, background #0a0d12), this just
         keeps the native window background/status bar from flashing white
         during the brief moment before the WebView finishes its first paint. -->
    <style name="Theme.Nova" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/nova_bg</item>
        <item name="android:statusBarColor">@color/nova_bg</item>
        <item name="android:navigationBarColor">@color/nova_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
